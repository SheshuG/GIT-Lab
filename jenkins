pipeline {
    agent any
environment {
        DEPLOY_DIR = "${env.WORKSPACE}/hello"
    }
stages {
        stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/SheshuG/JavaWebCalculator.git'
            }
        }
stage('Build') {
            steps {
                echo 'Building the project...'
                sh 'mvn clean package' // Adjust for your build tool
            }
        }
stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'mvn sonar:sonar \
              -Dsonar.projectKey=-_:55 \
              -Dsonar.host.url=http://10.0.2.15:9000 \
              -Dsonar.login=b75e7b19399cdca4342a0730adc64044a96b316b'
            }
        }
stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh """
                mkdir -p ${DEPLOY_DIR}
                cp target/*.war ${DEPLOY_DIR}/
                """
            }
        }
    }
post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
